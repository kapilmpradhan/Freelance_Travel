{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "doctrine/dbal": "^3.9",
        "firebase/php-jwt": "^6.10",
        "fruitcake/laravel-cors": "dev-develop",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.7",
        "kreait/firebase-php": "^7.16",
        "laravel/framework": "^10.0",
        "laravel/pennant": "^1.16",
        "laravel/sanctum": "^3.2",
        "laravel/socialite": "^5.16",
        "laravel/telescope": "^5.9",
        "laravel/tinker": "^2.8",
        "league/csv": "^9.21",
        "monolog/monolog": "^3.8",
        "predis/predis": "^2.3",
        "rap2hpoutre/laravel-log-viewer": "^2.4",
        "symfony/mailer": "^6.3"
    },
    "require-dev": {
        "behat/behat": "^3.14",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.64",
        "laravel/sail": "^1.21",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.2",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Common/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test-bdd": [
            "rm database/database.testing.sqlite && kill $(lsof -t -i:8000) &",
            "touch database/database.testing.sqlite",
            "php artisan migrate --env=testing",
            "php artisan serve --port=8000 --env=testing > /dev/null 2>&1 & disown &",
            "APP_ENV=testing vendor/bin/behat",
            "kill $(lsof -t -i:8000) && rm database/database.testing.sqlite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
